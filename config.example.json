    "writes_gib_limit": 150000,
    "writes_gib_limit_per_host": {"pbs": 75000, "pve4": 75000},
    "disk_hot_celsius": 60,
    "nvme_used_percent": 80
  },
  "replication_max_age_s": 3600,
  "offsite_max_age_s": 93600,
  "links": {
    "Proxmox UI": "https://pve1.example.com:8006",
    "PBS UI": "https://pbs.example.com:8007"
